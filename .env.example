# Copiez ce fichier en `.env` (ou `.env.local`) et remplissez les valeurs.
# Toutes les variables exposées au navigateur DOIVENT commencer par VITE_.

# Variables publiques du navigateur
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STUDIO_ADDRESS=

# Variables serveur Vercel — ne jamais les préfixer avec VITE_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM="L'instant précieux <bonjour@votre-domaine.fr>"
ADMIN_EMAIL=
SITE_URL=http://localhost:4173
VITE_SITE_URL=http://localhost:4173
